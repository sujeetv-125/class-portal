# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/classportal?retryWrites=true&w=majority

# JSON Web Token Secret (used for signing custom backend session tokens)
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Credentials (used for file/document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Client SDK Configuration (Required for client authentication)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Optional: Firebase Admin SDK Credentials (JSON content as a string or file path)
# If not provided, server-side validation will fallback to standard verification methods
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Server configuration
PORT=5000
